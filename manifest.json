{
  "manifest_version": 3,
  "name": "简历投递与进度管理助手",
  "version": "2.2.0",
  "description": "秋招网申全链路提效工具：网申表单快速填报、岗位一键提取收录、全屏投递管理看板与可视化简历资料库。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "简历投递与进度管理助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["autofill.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "ocr/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
